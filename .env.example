# ---- Server (prefix COOKING_) ----
COOKING_DATABASE_URL=sqlite:///./data/cooking.db
# rule (default, offline) | ollama | openai
COOKING_AGENT_PROVIDER=rule
COOKING_LLM_TIMEOUT_SECONDS=20
COOKING_OLLAMA_BASE_URL=http://localhost:11434
COOKING_OLLAMA_MODEL=qwen2.5:7b
# Official API key only. Leave empty to stay rule-based.
COOKING_OPENAI_API_KEY=
COOKING_OPENAI_MODEL=gpt-4o-mini
COOKING_RESPECT_ROBOTS_TXT=true
COOKING_FETCH_TIMEOUT_SECONDS=15
# "고추는 빼고 진행할게" 처럼 명시적인 저영향 재료 제외는 확인 없이 바로 적용
COOKING_AUTO_APPLY_EXPLICIT_EXCLUSION=true

# ---- Voice client (prefix COOKING_CLIENT_) ----
COOKING_CLIENT_SERVER_URL=http://127.0.0.1:8000
COOKING_CLIENT_TTS_VOICE=Yuna
COOKING_CLIENT_TTS_RATE=190
COOKING_CLIENT_STT_MODEL=small
COOKING_CLIENT_SILENCE_STOP_SECONDS=1.5
COOKING_CLIENT_MAX_RECORD_SECONDS=15
COOKING_CLIENT_POLL_INTERVAL_SECONDS=2
